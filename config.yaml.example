---
# Example config
# Precedence: explicit CLI > environment > YAML > defaults. Unknown keys are errors.

# Api server address
api:
  address: 0.0.0.0
  port: 8080

# Debug options
debug:
  # Debug listener address
  address: localhost

  # Debug listener port
  # Set this to a non-zero value to enable debug listener
  port: 0

# Input plugin to use
input: chainsync

# Output plugin to use (default: log; use its level: error for errors-only logging)
output: log

# Kupo URL for querying UTxOs (optional)
#kupo_url: http://localhost:1442

# Mainnet epoch calculation defaults from internal/config.New.
# Network selection below does not change these process-wide genesis settings.
# For the repository's preview setup, use config-preview.yaml instead.
shelley_trans_epoch: 208
byron_genesis:
  end_slot: 4492799
  epoch_length: 21600
  byron_slots_per_epoch: 21600
shelley_genesis:
  epoch_length: 432000

# Plugin options
plugins:

  # Input plugin options
  input:
    # Chainsync input plugin options
    chainsync:
      # Network to connect to (mainnet, preview, or preprod)
      network: mainnet
      # For testnet use: network: preview or network: preprod
      # Alternatively, specify socket path and network magic:
      #socket-path: /path/to/node.socket
      #network-magic: 764824073  # mainnet magic

  # Output plugin options
  output:
    # Log output plugin options
    log:
      # Logging threshold for events and application diagnostics
      # Event records are INFO-level; warn/error consume without writing
      level: info
      # Event format: text or json
      format: text
